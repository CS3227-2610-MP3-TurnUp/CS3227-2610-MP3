generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

// Synthetic-only persistence fixture used by an explicitly protected hosting check.
// Product records remain separate from this synthetic fixture.
model FoundationProbe {
  id        String   @id @db.Uuid
  marker    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probe")
}

// Durable aggregate admission state for the protected synthetic SoC probe.
// It remains inert in Production, where the route is disabled.
model SoCProbeGate {
  id                   Int                   @id @default(1)
  attemptCount         BigInt                @default(0) @map("attempt_count")
  inFlightCount        BigInt                @default(0) @map("in_flight_count")
  reservedOutputTokens BigInt                @default(0) @map("reserved_output_tokens")
  lastAdmissionAt      DateTime?             @map("last_admission_at") @db.Timestamptz(6)
  maxAttemptsLimit     BigInt?               @map("max_attempts_limit")
  maxInFlightLimit     BigInt?               @map("max_in_flight_limit")
  minIntervalMs        BigInt?               @map("min_interval_ms")
  outputTokenBudget    BigInt?               @map("output_token_budget")
  reservations         SoCProbeReservation[]

  @@map("soc_probe_gate")
}

// A lease identifies exactly one admitted request so retries or late releases
// cannot decrement another request's in-flight slot.
model SoCProbeReservation {
  id        String       @id @db.Uuid
  gateId    Int          @default(1) @map("gate_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  gate      SoCProbeGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("soc_probe_reservation")
}

// Separate per-database hosted product budget; activation never resets counters.
model StudentAiBudget {
  id Int @id
  approvalId String @unique @map("approval_id")
  environment String
  model String
  enabled Boolean @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts Int @default(0)
  reservedOutputTokens Int @default(0) @map("reserved_output_tokens")
  lastAdmissionAt DateTime? @map("last_admission_at") @db.Timestamptz(6)
  reservations StudentAiReservation[]
  @@map("student_ai_budget")
}

model StudentAiReservation {
  id String @id @db.Uuid
  budgetId Int @map("budget_id")
  requestKey String @unique @map("request_key") @db.Char(64)
  actorKey String @map("actor_key") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(6)
  released Boolean @default(false)
  budget StudentAiBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  @@index([actorKey, createdAt])
  @@map("student_ai_reservation")
}

enum AccountRole {
  STUDENT
  ORGANISER
}

model User {
  id           String      @id @db.Uuid
  username     String      @unique @db.VarChar(32)
  passwordHash String      @map("password_hash")
  credentialVersion Int    @default(0) @map("credential_version")
  studentName String?      @map("student_name")
  studentPhone String?     @map("student_phone")
  profileVersion Int       @default(0) @map("profile_version")
  role         AccountRole
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  aiHistory StudentAiHistory[]
  sessions     Session[]
  events       Event[]
  registrations Registration[]
  registrationOperations RegistrationOperation[]

  @@map("app_user")
}

model Session {
  tokenDigest String   @id @map("token_digest") @db.Char(64)
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model AuthThrottle {
  key       String   @id @db.VarChar(160)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_throttle")
}

enum EventState {
  DRAFT
  PUBLISHED
  WITHDRAWN
  CANCELLED
}

model Event {
  aiHistory StudentAiHistory[]
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  state EventState @default(DRAFT)
  version Int @default(0)
  draft Json
  draftForm Json @default("{\"questions\":[]}") @map("draft_form")
  draftVersion Int @default(0) @map("draft_version")
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz(6)
  currentPublicationId String? @unique @map("current_publication_id") @db.Uuid
  currentPublication EventPublication? @relation("CurrentPublication", fields: [currentPublicationId], references: [id], onDelete: Restrict)
  publications EventPublication[] @relation("PublicationHistory")
  approvals EventApproval[]
  registrations Registration[]
  registrationOperations RegistrationOperation[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt DateTime @default(now()) @map("edited_at") @db.Timestamptz(6)
  @@index([ownerId, editedAt])
  @@map("event")
}

model EventPublication {
  id String @id @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation("PublicationHistory", fields: [eventId], references: [id], onDelete: Restrict)
  currentFor Event? @relation("CurrentPublication")
  joinedRegistrations Registration[]
  submissions RegistrationSubmission[]
  revision Int
  snapshot Json
  digest String @db.Char(64)
  approvedBy String @map("approved_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([eventId, revision])
  @@map("event_publication")
}

model EventApproval {
  id String @id @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId String @map("actor_id") @db.Uuid
  eventVersion Int @map("event_version")
  draftVersion Int @map("draft_version")
  snapshot Json
  digest String @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([eventId])
  @@map("event_approval")
}


enum RegistrationState {
  ACTIVE
  CANCELLED
}
enum RegistrationOperationKind {
  JOIN
  CANCEL
  CORRECT
}
model Registration {
  id String @id @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentId String @map("student_id") @db.Uuid
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  state RegistrationState
  generation Int
  version Int
  joinedPublicationId String @map("joined_publication_id") @db.Uuid
  joinedPublication EventPublication @relation(fields: [joinedPublicationId], references: [id], onDelete: Restrict)
  joinedAt DateTime @map("joined_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  currentSubmissionId String? @unique @map("current_submission_id") @db.Uuid
  currentSubmission RegistrationSubmission? @relation("CurrentSubmission", fields: [currentSubmissionId], references: [id], onDelete: Restrict)
  submissions RegistrationSubmission[] @relation("SubmissionHistory")
  @@unique([studentId, eventId])
  @@index([eventId, state])
  @@index([studentId, joinedAt])
  @@map("registration")
}
model RegistrationSubmission {
  id String @id @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  registration Registration @relation("SubmissionHistory", fields: [registrationId], references: [id], onDelete: Restrict)
  currentFor Registration? @relation("CurrentSubmission")
  generation Int
  version Int
  publicationId String @map("publication_id") @db.Uuid
  publication EventPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  formRevisionId String @map("form_revision_id") @db.Uuid
  capturedForm Json @map("captured_form")
  profileName String? @map("profile_name")
  profilePhone String? @map("profile_phone")
  answers Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([registrationId, generation, version])
  @@unique([id, registrationId, generation])
  @@map("registration_submission")
}
model RegistrationOperation {
  actorId String @map("actor_id") @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  eventId String @map("event_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  operation RegistrationOperationKind
  key String @db.Uuid
  payloadDigest String @map("payload_digest") @db.Char(64)
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([actorId, eventId, operation, key])
  @@index([createdAt])
  @@map("registration_operation")
}

model StudentAiHistory {
  userId String @map("user_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  requestId String @map("request_id") @db.VarChar(128)
  revision String @db.VarChar(128)
  payload Json
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@id([userId,eventId,requestId])
  @@index([userId,eventId,revision,createdAt], map: "student_ai_history_lookup")
  @@index([expiresAt], map: "student_ai_history_expiry")
  @@map("student_ai_history")
}
