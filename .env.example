# Local application environment. Copy to .env.local and replace URLs with
# synthetic-only Neon non-production credentials. Never use production secrets here.
TURNUP_ENVIRONMENT=development
DATABASE_ENVIRONMENT=non-production

# Runtime uses a Neon pooled endpoint (the host contains "-pooler") and requires TLS.
# Add `?sslmode=require` to the Neon-generated URL unless it already includes SSL mode.
DATABASE_URL=

# Prisma migrations use direct endpoints with `sslmode=require&sslaccept=strict`.
# The shadow resource is required only for `pnpm db:migrate:dev` and must be separate
# from the migration target. `prisma migrate reset` is rejected for production labels.
MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=

# Server-only SoCLaaS settings. Select the model and numeric limits after G04 validation.
SOCLAAS_API_KEY=
# Student assistant only. Never falls back to the shared/Organiser key above.
# Set separately in Vercel Preview; never prefix with NEXT_PUBLIC_.
STUDENT_SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=
SOCLAAS_MODEL=
SOCLAAS_MAX_INPUT_BYTES=
SOCLAAS_MAX_OUTPUT_TOKENS=
SOCLAAS_TIMEOUT_MS=

# Hosted Student AI: explicit per-environment enablement and separate durable
# 200-attempt budgets in Preview and Production, approved on22October2026.
# Workflow activates each once; redeploy never resets counters or local allowance.
STUDENT_ASSISTANT_ENABLED=false

# Internal persistence probe. Keep disabled by default in preview; only enable after
# configuring an operator-generated token with at least 32 bytes.
FOUNDATION_PROBE_ENABLED=
FOUNDATION_PROBE_TOKEN=

# Shared Preview-only SoCLaaS admission limits. There are intentionally no defaults;
# populate only after verifying the selected model/key quotas under G04.
FOUNDATION_PROBE_SOC_MAX_ATTEMPTS=
FOUNDATION_PROBE_SOC_MAX_IN_FLIGHT=
FOUNDATION_PROBE_SOC_MIN_INTERVAL_MS=
FOUNDATION_PROBE_SOC_OUTPUT_TOKEN_BUDGET=

# Set only when opting into the destructive gate integration test against its
# dedicated disposable development database; never set this for Preview.
SOC_PROBE_GATE_TEST_DATABASE_NAME=

# Account settings, server-only. Exact browser origin, without trailing slash/path.
# Local mode requires development + loopback origin; ignore all forwarded IP headers.
# Hosted Vercel requires HTTPS + vercel mode; never enable local mode on a host.
AUTH_ORIGIN=http://localhost:3000
AUTH_SOURCE_MODE=local
# Set privately to 32–64 cryptographically random bytes encoded as 64–128 hex digits.
# Stable across instances/redeploys so persistent admission counters stay effective.
AUTH_THROTTLE_SECRET=

# Optional, explicit opt-in for assigned Darryl-owned synthetic auth SQL tests only.
# No env file is automatically loaded by that suite. Supply process settings privately.
RUN_AUTH_DB_INTEGRATION=
AUTH_TEST_OWNER=
# Exact DIRECT endpoint hostname and database name, matching the pooled/direct pair.
AUTH_TEST_ENDPOINT_HOST=
AUTH_TEST_DATABASE_NAME=
