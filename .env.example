# Local application environment. Copy to .env.local and replace URLs with
# synthetic-only Neon non-production credentials. Never use production secrets here.
TURNUP_ENVIRONMENT=development
DATABASE_ENVIRONMENT=non-production

# Runtime uses a Neon pooled endpoint (the host contains "-pooler") and requires TLS.
# Add `?sslmode=require` to the Neon-generated URL unless it already includes SSL mode.
DATABASE_URL=

# Prisma migrations use direct endpoints. The shadow resource is required only for
# `pnpm db:migrate:dev`, must be separate from the migration target, and requires TLS.
MIGRATION_DATABASE_URL=
SHADOW_DATABASE_URL=

# Server-only SoCLaaS settings. Select the model and numeric limits after G04 validation.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=
SOCLAAS_MODEL=
SOCLAAS_MAX_INPUT_BYTES=
SOCLAAS_MAX_OUTPUT_TOKENS=
SOCLAAS_TIMEOUT_MS=

# Internal persistence probe. Keep disabled by default in preview; only enable after
# configuring an operator-generated token with at least 32 bytes.
FOUNDATION_PROBE_ENABLED=
FOUNDATION_PROBE_TOKEN=
